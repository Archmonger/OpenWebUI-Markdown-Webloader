# Server
API_PORT=14786
HOST=0.0.0.0

# Authentication: set to require `Authorization: Bearer <API_KEY>` on all
# endpoints except /health. Leave unset for no auth (only do this behind a
# trusted proxy / on a private network).
# API_KEY=change-me

# Request / safety limits (wired to the same knobs mcp-searxng's web_url_read
# exposes) — all are integers except the booleans.
REQUEST_TIMEOUT_MS=30000
URL_READ_MAX_CONTENT_LENGTH_BYTES=5242880
URL_READ_MAX_PDF_PAGES=500
URL_READ_MAX_PDF_BYTES=16777216
PDF_TIMEOUT_MS=30000
MAX_REDIRECTS=5
MAX_BATCH_URLS=100
MAX_CONCURRENT_URLS=10

# Response cache
CACHE_TTL_MS=86400000
CACHE_MAX_ENTRIES=500

# User agent for outbound fetches (overridable per request via x-user-agent)
# USER_AGENT=Mozilla/5.0 ...

# SSRF defense. NEVER set ALLOW_PRIVATE_URLS=true on a public server.
ALLOW_PRIVATE_URLS=false

# Egress proxy for outbound fetches (undici ProxyAgent). Optional.
# PROXY_URL=http://proxy:3128
# NO_PROXY=localhost,127.0.0.1

# Logging: off | error | warn | info | debug
LOG_LEVEL=info

# ===========================================================================
# HTML PRE-CLEANING (Readability via dom_smoothie) — ON by default
# ===========================================================================
# Every HTML document is run through `dom_smoothie_cli` (a Rust port of Mozilla
# Readability) BEFORE it reaches either renderer (native node-html-markdown or
# the AI sidecar). This strips navigation / header / footer chrome so both paths
# see article content only. The bundled binary is fully static, so it needs no
# system libraries. It degrades gracefully: if the cleaner is ever missing,
# errors, times out, or yields empty output, the ORIGINAL html is used, so this
# can never break a conversion.

# Master switch. 1/true (default) enables pre-cleaning for BOTH paths; 0/false
# feeds raw HTML to both.
PREPROCESS_HTML=1

# Per-document timeout for the cleaner (ms). Past this, fall back to raw HTML.
# Typical page: ~10-80 ms.
PREPROCESS_TIMEOUT_MS=3000

# Skip documents smaller than this many characters (subprocess not worth it).
PREPROCESS_MIN_CHARS=800

# Cap the number of DOM elements the cleaner processes. 0 = unlimited (default).
# Set a positive value to bound worst-case CPU on pathological documents.
PREPROCESS_MAX_ELEMENTS=0

# Override the binary path if you are not using the bundled one on PATH.
# PREPROCESS_BINARY=/usr/local/bin/dom_smoothie_cli

# ===========================================================================
# AI MARKDOWN CONVERSION (OPTIONAL) — opt-in, OFF by default
# ===========================================================================
# When AI_CONVERTER_ENABLED is unset or 0, the engine is a pure native
# (node-html-markdown) loader and NO AI dependency is installed or contacted.
# To use AI conversion you must ALSO run the converter sidecar
# (`docker compose --profile ai up -d`) — the loader only calls it over HTTP.

# Master switch for routing HTML through the AI (ReaderLM) converter.
# true/1 to enable; anything else (including unset) is OFF.
AI_CONVERTER_ENABLED=0

# Base URL of the converter sidecar. Inside docker compose the service name
# `ai-converter` resolves; for a bare-metal sidecar use http://localhost:8090.
AI_SERVICE_URL=http://ai-converter:8090

# Shared bearer token between the loader and the sidecar. Must match the
# AI_CONVERTER_TOKEN given to the sidecar. Leave empty for no auth (only safe
# on a trusted internal network).
# AI_CONVERTER_TOKEN=***

# Timeout (ms) for the loader->sidecar call. On exceed, fall back to native.
AI_CONVERT_TIMEOUT_MS=30000

# If the sidecar errors/times out, fall back to node-html-markdown (1/true).
# Set 0 to surface a 500 conversion error instead of a possibly-worse native one.
AI_FALLBACK_ON_ERROR=1

# Generation controls forwarded to the model. Defaults = greedy, the validated
# ReaderLM-v2 recipe (deterministic, faithful markdown).
AI_MAX_NEW_TOKENS=8192
AI_TEMPERATURE=0.0
AI_TOP_K=1
AI_TOP_P=1.0
# Optional RNG seed (>=0). No effect under greedy, which is already deterministic.
# AI_SEED=0

# Only route HTML documents within this size window to the AI path. Documents
# over max (or under min) are rendered natively (protects VRAM/latency).
AI_MIN_HTML_CHARS=1
AI_MAX_HTML_CHARS=2000000

# Cache AI output under a separate 'ai:' cache key so it never shadows the
# native rendering of the same URL. 1 to enable (recommended).
AI_CACHE_OUTPUT=1

# --- Sidecar-only settings (set for the ai-converter container) ---
# These do not affect the loader; they configure the GPU sidecar service.
# The sidecar's internal listen port is fixed at 8090 (loader relies on it).
# Only the host-publish port is tunable to avoid collisions:
# AI_HOST_PORT=8090

# Soft cap on how many conversions the sidecar will queue behind its single GPU
# owner thread. Beyond this it returns 503 (busy), which the loader treats as an
# AI failure and handles via its own fallback — graceful overload shedding so the
# queue can't grow unbounded and burn GPU on already-abandoned requests.
AI_MAX_QUEUE=50

# The JSON overlay merged into the sidecar's onnxruntime-genai config. This is
# the primary vendor knob — see ai-converter/README-vendors.md for vendor
# examples. The sidecar's built-in default (used when this is unset) is the
# proven NVIDIA set: CUDA graph capture + gpu_utilization_factor=0.9. Quote
# carefully in your .env if you override it.
# AI_RUNTIME_CFG={"model":{"decoder":{"session_options":{"provider_options":[{"cuda":{"enable_cuda_graph":"1"}}]}}},"engine":{"dynamic_batching":{"gpu_utilization_factor":0.9}}}

# ---- Sidecar BUILD args (docker build; not runtime env) --------------------
# Passed with `docker build --build-arg` (or compose build.args). They let a
# different GPU vendor swap the runtime without touching any code. Example
# validated values:
# AI_LINUX_PACKAGES=libgomp1 ca-certificates
# AI_PYTHON_DEPENDENCIES=onnxruntime-genai-cuda==0.16.0 onnxruntime-gpu==1.30.0 numpy
# AI_BUILDER_ARGS=-o /build/model -p int4 -e cuda --extra_options use_paged_attention=true paged_block_size=256 gpu_utilization_factor=0.8
